PROGRAM ParkingController
  VAR
    Entry_Sensor : BOOL := FALSE; (* Detects a car at the entrance *)
    Entry_HMI : BOOL AT %IX0.0 := FALSE; (* Detects a car at the entrance *)
    Entry_Request : BOOL := FALSE; (* Entry_Sensor OR Entry_HMI *)
    Exit_Request : BOOL := FALSE; (* Exit_Sensor OR Exit_HMI *)
    Reset_Request : BOOL := FALSE; (* Reset_Sensor OR Reset_HMI *)
    Exit_Sensor : BOOL := FALSE; (* Detects a car leaving *)
    Exit_HMI : BOOL AT %IX0.1 := FALSE; (* Detects a car leaving *)
    Reset_Counter : BOOL := FALSE; (* Resets the parking count *)
    Reset_HMI : BOOL AT %IX0.2 := FALSE; (* Resets the parking count *)
    Barrier_Open : BOOL AT %QX0.0 := FALSE; (* Commands the entrance barrier *)
    Lot_Full : BOOL AT %QX0.1 := FALSE; (* Indicates that capacity is reached *)
    Lot_Empty : BOOL AT %QX0.2 := TRUE; (* Indicates that no cars are parked *)
    Car_Count : INT AT %QW0 := 0; (* Current number of parked cars *)
    Max_Capacity : INT := 10; (* Maximum permitted cars *)
    ParkingCounter : CTUD;
    Load_Count : BOOL := FALSE;
  END_VAR

